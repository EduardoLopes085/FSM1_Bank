// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement()) // Usando Int e autoincremento para ID do usuário
  name          String    @db.VarChar(255) // Nome do usuário
  email         String    @unique @db.VarChar(255) // Email único
  password      String    @db.VarChar(255) // Senha criptografada
  ownedWallets  Wallet[]  @relation("UserWallets") // Relacionamento com as carteiras que o usuário possui
  sharedWallets WalletUser[] // Relacionamento com as carteiras compartilhadas pelo usuário
}

model Wallet {
  id       Int       @id @default(autoincrement()) // Usando Int e autoincremento para ID da carteira
  name     String    @db.VarChar(255) // Nome da carteira
  ownerId  Int      // Chave estrangeira que referencia o dono da carteira (usuário)
  owner    User     @relation(fields: [ownerId], references: [id], name: "UserWallets") // Relacionamento com o usuário dono da carteira
  expenses Expense[] // Relacionamento com as despesas da carteira
  users    WalletUser[] // Relacionamento com os usuários que compartilham a carteira
}

model WalletUser {
  id       Int   @id @default(autoincrement()) // Usando Int e autoincremento para ID do relacionamento
  userId   Int   // Chave estrangeira que referencia o usuário
  walletId Int   // Chave estrangeira que referencia a carteira
  user     User  @relation(fields: [userId], references: [id]) // Relacionamento com o usuário
  wallet   Wallet @relation(fields: [walletId], references: [id]) // Relacionamento com a carteira
}

model Expense {
  id        Int      @id @default(autoincrement()) // Usando Int e autoincremento para ID da despesa
  descricao String   @db.VarChar(80) // Descrição da despesa
  value     Float    // Valor da despesa
  date      DateTime @default(now()) // Data da despesa (com valor padrão para o momento da criação)
  category  String   @db.VarChar(20) // Categoria da despesa
  walletId  Int      // Chave estrangeira que referencia a carteira à qual a despesa pertence
  wallet    Wallet   @relation(fields: [walletId], references: [id]) // Relacionamento com a carteira
}



